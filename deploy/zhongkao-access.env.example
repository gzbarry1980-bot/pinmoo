NODE_ENV=production
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=https://zhongkao.pinmooconsulting.com
ALLOWED_ORIGINS=https://zhongkao.pinmooconsulting.com
DB_PATH=/var/lib/zhongkao-access/access.sqlite
ACCESS_MODE=preview
OTP_PROVIDER=disabled
PAYMENT_PROVIDER=disabled
ZHONGKAO_PRICE_FEN=999
ZHONGKAO_PRODUCT_CODE=guangzhou-zhongkao-lifetime
SESSION_DAYS=30
SERIAL_SESSION_DAYS=180
# 生成后只保存到 /etc/zhongkao-access.env（0600）；不要提交、不要写入前端文件。
SERIAL_ADMIN_API_KEY=replace-with-a-separate-at-least-32-random-character-secret
COOKIE_SECURE=true
TRUST_PROXY=true
SESSION_SECRET=replace-with-at-least-32-random-characters
IDENTITY_PEPPER=replace-with-an-independent-32-character-secret
