[Unit]
Description=Back up Guangzhou Zhongkao access database
After=zhongkao-access.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/zhongkao-access/current
EnvironmentFile=/etc/zhongkao-access.env
Environment=ZHONGKAO_BACKUP_DIR=/var/backups/zhongkao-access
Environment=ZHONGKAO_BACKUP_RETENTION_DAYS=30
ExecStart=/usr/bin/node /opt/zhongkao-access/current/backup.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/var/backups/zhongkao-access /var/lib/zhongkao-access
