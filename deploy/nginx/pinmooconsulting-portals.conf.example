server {
    listen 80;
    listen [::]:80;
    server_name admin.pinmooconsulting.com sjmj.pinmooconsulting.com talasa.pinmooconsulting.com agent.pinmooconsulting.com shs-agent.pinmooconsulting.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name admin.pinmooconsulting.com;

    ssl_certificate /etc/letsencrypt/live/pinmooconsulting.com-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pinmooconsulting.com-wildcard/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    include /etc/nginx/snippets/pinmoo-security-headers.conf;
    limit_req zone=pinmoo_site burst=60 nodelay;
    limit_conn pinmoo_conn 20;
    auth_basic Pinmoo_Admin;
    auth_basic_user_file /etc/nginx/.pinmoo_admin_htpasswd;

    root /opt/pimu_task_loop/netlify_publish/admin/public;
    index index.html;

    location /api/ {
        limit_req zone=pinmoo_api burst=20 nodelay;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / { try_files $uri $uri/ /index.html; }
}

