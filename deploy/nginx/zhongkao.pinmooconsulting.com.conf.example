server {
    listen 80;
    listen [::]:80;
    server_name zhongkao.pinmooconsulting.com;
    return 301 https://zhongkao.pinmooconsulting.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name zhongkao.pinmooconsulting.com;

    ssl_certificate /etc/letsencrypt/live/zhongkao.pinmooconsulting.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zhongkao.pinmooconsulting.com/privkey.pem;

    root /var/www/zhongkao.pinmoo.top/current;
    index index.html;

    include /etc/nginx/snippets/pinmoo-security-headers.conf;
    include /etc/nginx/snippets/pinmoo-server-protection.conf;
    include /etc/nginx/snippets/pinmoo-performance.conf;

    error_page 404 /404.html;
    location = /404.html { internal; }

    location ~ ^/api/serial-keys(?:/|$) {
        auth_basic "Pinmoo serial key manager";
        auth_basic_user_file /etc/nginx/.htpasswd-zhongkao-serial-manager;
        client_max_body_size 32k;
        limit_req zone=pinmoo_api burst=10 nodelay;
        limit_conn pinmoo_conn 10;
        proxy_http_version 1.1;
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Serial-Manager-User $remote_user;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    location ~ ^/api/access/ {
        client_max_body_size 32k;
        limit_req zone=pinmoo_api burst=10 nodelay;
        limit_conn pinmoo_conn 10;
        proxy_http_version 1.1;
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    # 管理页可访问但不得被搜索引擎收录或生成摘要。
    location ^~ /serial-key/ {
        # The manager page is protected separately from the API management key.
        auth_basic "Pinmoo serial key manager";
        auth_basic_user_file /etc/nginx/.htpasswd-zhongkao-serial-manager;
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" always;
        try_files $uri $uri/ =404;
        limit_except GET { deny all; }
    }

    # Revalidate HTML on every visit so interface releases appear immediately.
    location ~* \.html$ {
        try_files $uri =404;
        expires -1;
    }

    location / {
        try_files $uri $uri/ =404;
        limit_except GET { deny all; }
    }

    location ~ /\. { deny all; }
    location ~* \.(?:bak|conf|ini|log|old|sql|swp|tmp)$ { deny all; }
}
