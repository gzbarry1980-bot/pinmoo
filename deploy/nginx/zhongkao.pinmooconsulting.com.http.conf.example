# Temporary HTTP-only vhost used before the first TLS certificate is issued.
server {
    listen 80;
    listen [::]:80;
    server_name zhongkao.pinmooconsulting.com;

    root /var/www/zhongkao.pinmoo.top/current;
    index index.html;

    location ~ ^/api/serial-keys(?:/|$) {
        auth_basic "Pinmoo serial key manager";
        auth_basic_user_file /etc/nginx/.htpasswd-zhongkao-serial-manager;
        client_max_body_size 32k;
        limit_req zone=pinmoo_api burst=10 nodelay;
        limit_conn pinmoo_conn 10;
        proxy_http_version 1.1;
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Serial-Manager-User $remote_user;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    location ~ ^/api/access/ {
        client_max_body_size 32k;
        limit_req zone=pinmoo_api burst=10 nodelay;
        limit_conn pinmoo_conn 10;
        proxy_http_version 1.1;
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    location ^~ /serial-key/ {
        auth_basic "Pinmoo serial key manager";
        auth_basic_user_file /etc/nginx/.htpasswd-zhongkao-serial-manager;
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" always;
        try_files $uri $uri/ =404;
        limit_except GET { deny all; }
    }

    location / {
        try_files $uri $uri/ =404;
        limit_except GET { deny all; }
    }

    location ~ /\. { deny all; }
}
