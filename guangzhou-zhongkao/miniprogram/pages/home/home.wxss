.embed-page { min-height: 100vh; background: #f4f7fb; }.embed-status { height: 84rpx; display: flex; align-items: center; padding: 0 24rpx; background: #102a43; color: #fff; }.embed-mark { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border-radius: 13rpx; background: #3dc1b1; color: #0b2138; font-size: 23rpx; font-weight: 900; margin-right: 12rpx; }.embed-title, .embed-subtitle { display: block; }.embed-title { font-size: 24rpx; font-weight: 800; }.embed-subtitle { color: #b7dfe1; font-size: 18rpx; margin-top: 3rpx; }.embed-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #3dc1b1; margin-left: auto; box-shadow: 0 0 0 8rpx rgba(61,193,177,.15); }.embed-error { margin: 36rpx 28rpx; padding: 28rpx; background: #fff; border-radius: 20rpx; color: #627d98; }.error-title { color: #243b53; font-weight: 800; font-size: 30rpx; }.error-text { font-size: 23rpx; line-height: 1.6; margin-top: 10rpx; }.retry-button { margin-top: 22rpx; background: #0b7285; color: #fff; }
