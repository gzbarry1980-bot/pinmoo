page {
  background: #f4f7fb;
  color: #243b53;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.4;
}

view, text, button, input, picker {
  box-sizing: border-box;
}

button {
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 2.8;
  padding-left: 28rpx;
  padding-right: 28rpx;
}

button::after { border: 0; }

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(72rpx + env(safe-area-inset-bottom));
}

.muted {
  color: #829ab1;
}

.eyebrow {
  color: #0b7285;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.card {
  background: #fff;
  border: 1rpx solid #e6edf4;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(16, 42, 67, .055);
}

.primary-button {
  background: #0b7285;
  color: #fff;
  font-weight: 700;
}

.secondary-button {
  background: #e6f6f8;
  color: #0b7285;
}

.ghost-button {
  background: #fff;
  border: 1rpx solid #d9e2ec;
  color: #486581;
}

.page-heading { position: relative; }
.eyebrow { display: inline-flex; align-items: center; }
.eyebrow::before { content: ''; display: inline-block; width: 12rpx; height: 12rpx; border-radius: 50%; background: #3dc1b1; margin-right: 10rpx; }

.embed-page web-view { display: block; width: 100%; height: calc(100vh - 84rpx - env(safe-area-inset-bottom)); }
