# /etc/zhongkao-pay/env —— 真实微信支付凭证（权限 600，属主 root，禁止进 Git）
#
# 用法：复制本文件为 /etc/zhongkao-pay/env 并逐项填写，然后执行
#   bash server/deploy/install-wxpay-env.sh
#
# 说明：
#  - 私钥 / 平台公钥为多行 PEM，systemd EnvironmentFile 不支持换行值，
#    因此这里只写**文件路径**（config.js 检测到不含 -----BEGIN 时会按路径读取文件内容）。
#  - 其余为单行值，可直接内联。
#  - 本文件权限必须是 600，属主 root；服务以 EnvironmentFile=- 方式加载（文件缺失也能启动）。

# ---------- 小程序身份（登录用，缺这两项 /api/auth/login 返回 503） ----------
WX_APPID=
WX_APPSECRET=

# ---------- 商户身份（下单/查单/回调用） ----------
# 微信支付商户号，10 位数字
WX_MCHID=
# 商户 API 证书序列号（商户平台 → API安全 → API证书 → 证书序列号），40 位十六进制大写
WX_MCH_SERIAL=
# 商户 API 私钥 apiclient_key.pem 的绝对路径
WX_MCH_PRIVATE_KEY=/etc/zhongkao-pay/apiclient_key.pem
# APIv3 密钥（商户平台自行设置，32 字节）
WX_API_V3_KEY=
# 微信支付平台公钥 / 平台证书公钥 PEM 的绝对路径
WX_PLATFORM_PUBLIC_KEY=/etc/zhongkao-pay/wechatpay_platform_pubkey.pem

# ---------- 业务参数（可缺省，使用默认值） ----------
# 回调与页面基址，必须与小程序业务域名一致
PUBLIC_BASE_URL=https://zhongkao.pinmooconsulting.com
# 商品单价（分）。联调期可临时改 1 分，正式必须为 990
PAY_PRICE_FEN=990
PAY_PRODUCT_NAME=广州中考志愿模拟会员
TOKEN_TTL_DAYS=30
WEB_SESSION_TTL_DAYS=30
COOKIE_SECURE=true
SESSION_CODE_TTL_SEC=60
DEMO_ENABLED=false
SERIAL_BACKEND_URL=http://127.0.0.1:8787
